NODE_ENV=development

# Development
DEV_CLIENT_HOSTNAME=http://localhost
DEV_CLIENT_PORT=3000
DEV_SERVER_PORT=3001

# Production
PROD_CLIENT_HOSTNAME=PROD_CLIENT_HOSTNAME
PROD_SERVER_PORT=3001

#####################################################################################
# PostgreSQL (server/db/db-pgp.ts) and MySQL (server/db/db-mysql.ts)
# Keep only if using one of these databases. DB_PORT is only read by Postgres.
#####################################################################################
DEV_DB_HOSTNAME=DEV_DB_HOSTNAME
DEV_DB_USERNAME=postgres
DEV_DB_PORT=5432
DEV_DB_NAME=postgres
DEV_DB_PASSWORD=DEV_DB_PASSWORD

PROD_DB_HOSTNAME=PROD_DB_HOSTNAME
PROD_DB_USERNAME=PROD_DB_USERNAME
PROD_DB_PORT=5432
PROD_DB_NAME=PROD_DB_NAME
PROD_DB_PASSWORD=PROD_DB_PASSWORD

#####################################################################################
# AWS S3 file uploads (server/common/s3.ts)
# Keep only if using S3.
#####################################################################################
# S3_BUCKET_NAME=S3_BUCKET_NAME
# DEV_S3_REGION=us-west-1
# DEV_S3_ACCESS_KEY_ID=DEV_S3_ACCESS_KEY_ID
# DEV_S3_SECRET_ACCESS_KEY=DEV_S3_SECRET_ACCESS_KEY
# PROD_S3_REGION=us-west-1
# PROD_S3_ACCESS_KEY_ID=PROD_S3_ACCESS_KEY_ID
# PROD_S3_SECRET_ACCESS_KEY=PROD_S3_SECRET_ACCESS_KEY

#####################################################################################
# Email via Nodemailer (server/common/transporter.ts)
# Keep only if sending email.
#####################################################################################
# DEV_EMAIL_USERNAME=DEV_EMAIL_USERNAME
# DEV_EMAIL_PASSWORD=DEV_EMAIL_PASSWORD
# DEV_EMAIL_FIRSTNAME=DEV_EMAIL_FIRSTNAME
# DEV_EMAIL_LASTNAME=DEV_EMAIL_LASTNAME
# PROD_EMAIL_USERNAME=PROD_EMAIL_USERNAME
# PROD_EMAIL_PASSWORD=PROD_EMAIL_PASSWORD
# PROD_EMAIL_FIRSTNAME=PROD_EMAIL_FIRSTNAME
# PROD_EMAIL_LASTNAME=PROD_EMAIL_LASTNAME
